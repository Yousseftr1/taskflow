# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# `.env` is git-ignored. `.env.example` is committed so every developer
# knows WHICH variables they need, without ever sharing the secrets.

# Supabase project URL — Dashboard > Project Settings > Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# Public "anon" key — safe for client apps, protected by Row Level Security.
# Dashboard > Project Settings > API Keys
SUPABASE_ANON_KEY=your-anon-key-here
